[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = BootConfigProtocolLib
  FILE_GUID                      = f864d58f-e550-4286-a330-cdb0a35e7565
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = BootConfigProtocolLib

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  NetworkPkg/NetworkPkg.dec
  Silicon/NVIDIA/NVIDIA.dec

[LibraryClasses]
  MemoryAllocationLib
  IoLib
  NctLib
  BootChainInfoLib
  AndroidBcbLib
#
# DxeServicesTableLib (gDS) is only valid in DXE-phase and later modules.
# BootConfigProtocolLib stays MODULE_TYPE = BASE (it is linked into BASE
# libraries such as AvbLib and into UEFI_APPLICATION consumers), so the
# dependency is scoped to the module types that actually consume it rather
# than declared unconditionally for a BASE library. GetPmcBootReason() also
# guards against a NULL gDS at runtime. No BASE/PEI/SMM root module consumes
# this library.
#
# TegraPlatformInfoLib is only referenced under
# PcdBootConfigEnableSecurityModeFuse == TRUE. Platforms that do not
# enable that PCD (e.g. TegraVirt) do not resolve this library class,
# so the reference is compile-time-gated in the .c file instead of
# being listed here unconditionally.
#

[LibraryClasses.common.DXE_DRIVER, LibraryClasses.common.DXE_RUNTIME_DRIVER, LibraryClasses.common.UEFI_DRIVER, LibraryClasses.common.UEFI_APPLICATION, LibraryClasses.common.HOST_APPLICATION]
  DxeServicesTableLib

[Sources.common]
  BootConfigProtocolLib.c
  T23xPmcBootReason.c
  T23xPmcBootReason.h

[Pcd]

[FixedPcd]
  gNVIDIATokenSpaceGuid.PcdBootConfigEnableSecurityModeFuse
  gNVIDIATokenSpaceGuid.PcdBootReasonPmcRstStatusAddress

[Guids]

[Protocols]
  gNVIDIABootConfigUpdateProtocol             ## SOMETIMES_PRODUCES
  gNVIDIACvmEepromProtocolGuid                ## SOMETIMES_CONSUMES
  gNVIDIAEFuseProtocolGuid                    ## SOMETIMES_CONSUMES
