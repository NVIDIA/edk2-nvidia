[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = CxlDxe
  FILE_GUID                      = 646fddcf-eb12-4cf4-a013-783cd0937719
  MODULE_TYPE                    = UEFI_DRIVER
  VERSION_STRING                 = 1.0

  ENTRY_POINT                    = InitializeCxlDxe

[Sources.common]
  CxlDxe.c

